# Supabase の「Project Settings → API Keys / Data API」からコピーして .env.local に貼り付けます
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- AI機能（音声入力・成分表示の読み取り）---
# Anthropic Console (https://platform.claude.com) で作成した API キー。サーバー側だけで使われ、スマホには送られません
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# 使うモデル（省略時 claude-opus-5-5）。安くしたいときは claude-haiku-5-5 など
# AI_MODEL=claude-opus-5-5
# 1人1日あたりのAI利用回数の上限（省略時 30）
# AI_DAILY_LIMIT=30
